{%- assign fc = section.settings.collection -%}
{%- if fc == blank -%}
  {%- assign fc = collections.all -%}
{%- endif -%}
<section class="section">
  <div class="container">
    <div class="section-head">
      <h2>{{ section.settings.heading }}</h2>
      <a href="{{ fc.url }}">View all</a>
    </div>
    <div class="grid">
      {%- for product in fc.products limit: section.settings.products_to_show -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <p class="muted">Add products to this collection to show them here.</p>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bestsellers" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to show all products." },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
