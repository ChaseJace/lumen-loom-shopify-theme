<section class="section" style="padding-top:0">
  <div class="container">
    <div class="promo">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      {%- form 'customer', id: 'newsletter-form', class: 'newsletter' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="nl-{{ section.id }}">Email address</label>
        <input id="nl-{{ section.id }}" type="email" name="contact[email]" placeholder="you@example.com" autocomplete="email" required value="{{ form.email }}"{% if form.errors %} aria-invalid="true"{% endif %}>
        <button type="submit" class="btn btn-light">Subscribe</button>
        {%- if form.posted_successfully? -%}
          <p class="form-message" role="status">Thanks for subscribing!</p>
        {%- endif -%}
        {%- if form.errors -%}
          <p class="form-message" role="alert">{{ form.errors | default_errors }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get 10% off your first order" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Join our list for new arrivals, restocks and the occasional sale." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
