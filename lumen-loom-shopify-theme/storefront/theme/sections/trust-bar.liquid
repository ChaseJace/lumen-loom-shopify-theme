<div class="container">
  <div class="trust" role="list">
    {%- for block in section.blocks -%}
      <div role="listitem" {{ block.shopify_attributes }}>
        <strong>{{ block.settings.title }}</strong>{{ block.settings.text }}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Trust bar",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Free shipping" },
        { "type": "text", "id": "text", "label": "Text", "default": "on orders over $75" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }]
    }
  ]
}
{% endschema %}
