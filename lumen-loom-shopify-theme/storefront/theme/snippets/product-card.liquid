{%- comment -%} Product card. Param: product (required). {%- endcomment -%}
<article class="card">
  <a class="card-img" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200, 300, 400, 600', sizes: '(min-width: 1000px) 23vw, (min-width: 700px) 31vw, 47vw' }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
    {%- endif -%}
    {%- if product.available == false -%}
      <span class="tag soldout">Sold out</span>
    {%- elsif product.compare_at_price > product.price -%}
      <span class="tag sale">Sale</span>
    {%- elsif product.tags contains 'New' -%}
      <span class="tag">New</span>
    {%- endif -%}
  </a>
  <div class="card-body">
    <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
    <div class="price">{% render 'price', product: product %}</div>
    <div class="card-foot">
      {%- if product.available and product.variants.size == 1 -%}
        {%- form 'product', product, class: 'quick-add', novalidate: 'novalidate', data-product-form: '' -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button type="submit" name="add" class="btn secondary block">{{ 'general.add_to_cart' | t }}</button>
        {%- endform -%}
      {%- else -%}
        <a class="btn secondary block" href="{{ product.url }}">
          {%- if product.available %}Choose options{% else %}View product{% endif -%}
        </a>
      {%- endif -%}
    </div>
  </div>
</article>
